{
  "name": "localapi-desktop",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "LocalAPI Desktop - Electron wrapper for LocalAPI relay with Vue admin",
  "main": "dist/main.js",
  "author": "localapi",
  "license": "GPL-3.0",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "tsc -p tsconfig.json",
    "dist": "pnpm build && electron-builder --win --x64",
    "dist:dir": "pnpm build && electron-builder --win --x64 --dir",
    "pack": "pnpm build && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.localapi.desktop",
    "productName": "LocalAPI",
    "copyright": "GPL-3.0",
    "directories": {
      "buildResources": "build",
      "output": "../release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server",
        "filter": ["**/*"]
      },
      {
        "from": "../dist-web",
        "to": "dist-web",
        "filter": ["**/*"]
      },
      {
        "from": "../.env.example",
        "to": ".env.example"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "LocalAPI-${version}-portable.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Development"
    }
  }
}
