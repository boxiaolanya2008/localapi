# 本地 API 中转站配置示例,复制为 .env 后填写真实值
# Port and bind address
PORT=3000
HOST=127.0.0.1

# 管理网页登录令牌(防局域网手滑访问)
ADMIN_TOKEN=change-me-to-a-long-random-string

# 主渠道:上游 API 地址、密钥、默认模型
BASE_URL=https://api.deepseek.com/v1
API_KEY=sk-your-upstream-key
MODEL=deepseek-chat

# 单价,单位:每千 token 的价格(币种随你,界面只做展示与抵扣估算)
PRICE_IN=0.00014
PRICE_OUT=0.00028

# 主渠道配置额度,用于本地估算余额:额度 - 累计消耗
CREDIT=10.0

# 模型映射,格式 本地名=上游名,逗号分隔。没有则原样转发
MODEL_MAP=

# 额外渠道,JSON 数组,可选
# [{"name":"openai","base_url":"https://api.openai.com/v1","api_key":"sk-xxx","models":["gpt-4o"],"price_in":0.005,"price_out":0.015,"credit":5,"billing_endpoint":""}]
EXTRA_CHANNELS_JSON=

# OpenAI 式查余额接口,留空则自动拼 BASE_URL/dashboard/billing/credit_grants
BILLING_ENDPOINT=

# 数据目录(存 SQLite),默认 <项目根>/data
DATA_DIR=